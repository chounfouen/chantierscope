# ------------------------------------------------------------------------------
# Variables d'environnement attendues. Aucune valeur secrete ici.
#
# Copier ce fichier en .env.local et renseigner les valeurs.
# ------------------------------------------------------------------------------

# Connexion applicative. En production : pooler Supabase, port 6543, mode
# transaction. Le client doit imposer prepare: false et max: 1.
DATABASE_URL="postgresql://UTILISATEUR:MOT_DE_PASSE@HOTE:5432/chantierscope"

# Connexion directe, port 5432. Reservee aux migrations : pgBouncer en mode
# transaction ne supporte ni les requetes preparees ni le DDL transactionnel.
DIRECT_URL="postgresql://UTILISATEUR:MOT_DE_PASSE@HOTE:5432/chantierscope"

# Generer avec : node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# Coordonnees du chantier, pour le releve meteo Open-Meteo.
CHANTIER_LATITUDE="5.3599"
CHANTIER_LONGITUDE="-3.9821"
CHANTIER_FUSEAU="Africa/Abidjan"

# Secret protegeant la route de cron.
CRON_SECRET=""

# Production uniquement — Supabase Storage pour les photos.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_BUCKET_PHOTOS="photos"
